<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>NSMicrophoneUsageDescription</key>
    <string>Konfer records your microphone so meetings can be transcribed on this Mac.</string>
    <!-- Recording one app's audio with a Core Audio process tap is gated behind
         System Audio Recording, which is its own permission and needs its own
         usage description. Without this key TCC refuses the tap without ever
         asking: every call still returns noErr and every buffer is zeros, so
         the recording comes out with a silent right channel and nothing says
         why. It has to live in this file — the INFOPLIST_KEY_ build setting
         for it is ignored, and `plutil -p` on the built bundle is the only
         proof that it made it. -->
    <key>NSAudioCaptureUsageDescription</key>
    <string>Konfer records the other side of a call or meeting so it can be transcribed on this Mac.</string>
    <key>SUEnableInstallerLauncherService</key>
    <true/>
    <key>SUFeedURL</key>
    <string>https://raw.githubusercontent.com/memfrag/Konfer/main/appcast.xml</string>
    <key>SUPublicEDKey</key>
    <string>AvJMcXvL9lwbU8D00Z9uECjR9zdeOlcsl7Rktg/hQVE=</string>
    <key>UTImportedTypeDeclarations</key>
    <array>
        <dict>
            <!-- SubRip is somebody else's format and macOS declares no type for
                 it, so this is an imported declaration rather than an exported
                 one. Without it a .srt export lands in a save panel that only
                 knows plain text and renames the file to .txt. WebVTT needs no
                 equivalent: org.w3.webvtt already exists. -->
            <key>UTTypeIdentifier</key>
            <string>org.subrip.srt</string>
            <key>UTTypeDescription</key>
            <string>SubRip Subtitles</string>
            <key>UTTypeConformsTo</key>
            <array>
                <string>public.plain-text</string>
            </array>
            <key>UTTypeTagSpecification</key>
            <dict>
                <key>public.filename-extension</key>
                <array>
                    <string>srt</string>
                </array>
            </dict>
        </dict>
    </array>
</dict>
</plist>
